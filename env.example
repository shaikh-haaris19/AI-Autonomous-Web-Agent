# Rename this file to .env when running the application locally on Windows.
# This configuration is intentionally for the local Windows runtime only.

# Ollama local service and model.
LOCAL_WINDOWS_RUNTIME=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=30000

# Browser research: `playwright` uses local Chromium; `fetch` enables read-only fallback extraction.
BROWSER_MODE=playwright

# Bounded local research settings.
AGENT_MAX_SOURCES=6
AGENT_REQUEST_TIMEOUT_MS=12000
AGENT_MAX_RETRIES=2

# Optional: enable durable run history. The agent works in memory without this value.
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/autonomous_web_agent
